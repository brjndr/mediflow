generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Scaffold demo model (used by /demo/prisma)
model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

enum PatientStatus {
  ADMITTED
  OUTPATIENT
  CRITICAL
  DISCHARGED
}

enum Stage {
  REGISTERED
  TRIAGE
  ADMITTED
  TREATMENT
  READY_FOR_DISCHARGE
  DISCHARGED
}

enum NoteKind {
  PROGRESS
  TRIAGE
  DISCHARGE
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

model Patient {
  id           String        @id @default(cuid())
  mrn          String        @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime      @db.Date
  gender       String
  phone        String
  ward         String
  status       PatientStatus @default(OUTPATIENT)
  condition    String
  admittedAt   DateTime      @default(now())
  stage        Stage         @default(REGISTERED)
  appointments Appointment[]
  stageEvents  StageEvent[]
  notes        ClinicalNote[]
  vitals       VitalsReading[]

  @@index([status])
  @@index([ward])
  @@index([stage])
}

model Doctor {
  id           String        @id @default(cuid())
  name         String
  specialty    String
  appointments Appointment[]
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  doctorId    String
  scheduledAt DateTime
  reason      String
  status      AppointmentStatus @default(SCHEDULED)
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor            @relation(fields: [doctorId], references: [id])

  @@index([scheduledAt])
}

model StageEvent {
  id        String   @id @default(cuid())
  patientId String
  fromStage Stage?
  toStage   Stage
  at        DateTime @default(now())
  by        String
  note      String?
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, at])
}

model ClinicalNote {
  id        String   @id @default(cuid())
  patientId String
  kind      NoteKind
  text      String
  at        DateTime @default(now())
  author    String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, at])
}

model VitalsReading {
  id           String   @id @default(cuid())
  patientId    String
  at           DateTime @default(now())
  heartRate    Int
  systolic     Int
  diastolic    Int
  temperatureC Float
  spo2         Int
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, at])
}
