# Copy to .env (git-ignored) and adjust if a port is already taken. Local development values only.

# Docker Compose
POSTGRES_USER=mediflow
POSTGRES_PASSWORD=mediflow
POSTGRES_DB=mediflow
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MINIO_ROOT_USER=mediflow
MINIO_ROOT_PASSWORD=mediflow-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379

# API (used from BE-01)
DATABASE_URL=postgres://mediflow:mediflow@localhost:5432/mediflow
DATABASE_URL_TEST=postgres://mediflow:mediflow@localhost:5432/mediflow_test
SMTP_URL=smtp://localhost:1025
