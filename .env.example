# --- Storage -----------------------------------------------------------
# memory (default): seeded in-process demo data, no database needed.
# prisma: use PostgreSQL via DATABASE_URL (run db:push + db:seed first).
HOSPITAL_STORAGE=memory
DATABASE_URL="postgresql://username:password@localhost:5432/mediflow"

# --- TanStack AI providers (first one set wins: Anthropic > OpenAI > Gemini) --
# With none set, the chat route falls back to a local Ollama (OLLAMA_HOST).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=      # also required for /demo/ai-image, TTS, transcription
GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
