{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/core/db/migrate-cli.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "platform:bootstrap": "tsx src/core/platform/bootstrap-cli.ts",
    "codes:load": "tsx src/features/codes/load-cli.ts",
    "gen:openapi": "tsx src/core/openapi/generate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/fast-json-stringify-compiler": "^5.1.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "nodemailer": "^10.3.1",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
