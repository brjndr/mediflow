{
  "name": "@mediflow/contract",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAPI spec (generated by apps/api) and the TypeScript types generated from it",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "gen": "openapi-typescript openapi.json -o src/generated/api.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3"
  }
}
