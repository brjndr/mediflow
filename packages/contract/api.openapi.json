                }
              }
            }
          }
        }
      }
    },
    "/auth/password/forgot": {
      "post": {
        "operationId": "forgotPassword",
        "tags": ["auth"],
        "description": "Emails a reset link if the address has an account. The answer is the same either way, so it cannot be used to find accounts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
