{
  "openapi": "3.1.0",
  "info": {
    "title": "Mediflow API",
    "version": "0.1.0",
    "description": "Generated from the API route schemas by `pnpm gen:api`. Do not edit by hand."
  },
  "components": {
    "schemas": {
      "Error": {
        "description": "Standard error body.",
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "description": "Stable machine-readable code, e.g. tenant_mismatch",
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "Tenant": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "locale",
          "timezone",
          "currency",
          "theme",
          "features",
          "auth",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "locale": {
            "description": "BCP 47, e.g. en-IN",
            "type": "string"
          },
          "timezone": {
            "description": "IANA, e.g. Asia/Kolkata",
            "type": "string"
          },
          "currency": {
            "description": "ISO 4217",
            "type": "string"
          },
          "theme": {
            "type": "object",
            "required": ["primary"],
            "properties": {
              "primary": {
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Brand colour as six-digit hex. Must read as text on a white background (contrast of at least 4.5:1); the web app falls back to its default colour otherwise.",
                "type": "string"
              },
              "logoUrl": {
                "description": "https or same-origin URL of the hospital logo (SVG or WebP, at most 50 kB).",
                "type": "string"
              }
            }
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Module flags. A module that is absent is off."
          },
          "auth": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["password", "sso"]
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["active", "suspended"],
            "description": "A suspended hospital keeps its data but its staff cannot use the app. Tenant-scoped routes answer 403 tenant_suspended."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      }
    }
  },
  "paths": {
    "/tenant": {
      "get": {
        "operationId": "getTenant",
        "tags": ["tenancy"],
        "description": "The active hospital of the session and its configuration. Private per session, never CDN-cached.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tenant"
                }
              }
            }
          },
          "401": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["system"],
        "description": "Liveness check. The process is running.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": ["system"],
        "description": "Readiness check. The process can reach its database.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health and readiness"
    },
    {
      "name": "tenancy",
      "description": "The active hospital and its configuration"
    }
  ]
}
