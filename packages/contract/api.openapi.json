{
  "openapi": "3.1.0",
  "info": {
    "title": "Mediflow API",
    "version": "0.1.0",
    "description": "Generated from the API route schemas by `pnpm gen:api`. Do not edit by hand."
  },
  "components": {
    "schemas": {
      "Error": {
        "description": "Standard error body.",
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "description": "Stable machine-readable code, e.g. tenant_mismatch",
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": ["tenantId", "tenantName", "roleId"],
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "name", "memberships", "mfaEnabled"],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          },
          "mfaEnabled": {
            "description": "Whether sign-in asks for an authenticator code.",
            "type": "boolean"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["user", "activeTenant", "policy"],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "activeTenant": {
            "description": "Null until a user with several hospitals picks one.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/Tenant"
              },
              {
                "type": "null"
              }
            ]
          },
          "policy": {
            "description": "Null when there is no active tenant.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccessPolicy"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "InvitePreview": {
        "type": "object",
        "required": ["email", "hospitalName", "needsPassword"],
        "properties": {
          "email": {
            "type": "string"
          },
          "hospitalName": {
            "type": "string"
          },
          "needsPassword": {
            "description": "False when this person already has an account: they only accept.",
            "type": "boolean"
          }
        }
      },
      "MfaEnrollment": {
        "type": "object",
        "required": ["secret", "otpauthUri"],
        "properties": {
          "secret": {
            "description": "Base32, for typing into an authenticator by hand.",
            "type": "string"
          },
          "otpauthUri": {
            "description": "For the QR code.",
            "type": "string"
          }
        }
      },
      "RecoveryCodes": {
        "type": "object",
        "required": ["recoveryCodes"],
        "properties": {
          "recoveryCodes": {
            "description": "One-time codes. Returned this once and never again.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Tenant": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "locale",
          "timezone",
          "currency",
          "theme",
          "features",
          "auth",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "locale": {
            "description": "BCP 47, e.g. en-IN",
            "type": "string"
          },
          "timezone": {
            "description": "IANA, e.g. Asia/Kolkata",
            "type": "string"
          },
          "currency": {
            "description": "ISO 4217",
            "type": "string"
          },
          "theme": {
            "type": "object",
            "required": ["primary"],
            "properties": {
              "primary": {
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Brand colour as six-digit hex. Must read as text on a white background (contrast of at least 4.5:1); the web app falls back to its default colour otherwise.",
                "type": "string"
              },
              "logoUrl": {
                "description": "https or same-origin URL of the hospital logo (SVG or WebP, at most 50 kB).",
                "type": "string"
              }
            }
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Module flags. A module that is absent is off."
          },
          "auth": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["password", "sso"]
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["active", "suspended"],
            "description": "A suspended hospital keeps its data but its staff cannot use the app. Tenant-scoped routes answer 403 tenant_suspended."
          }
        }
      },
      "PermissionGrant": {
        "type": "object",
        "required": ["permission"],
        "properties": {
          "permission": {
            "description": "resource:action",
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": ["all", "own", "department"]
          }
        }
      },
      "AccessPolicy": {
        "type": "object",
        "required": ["tenantId", "roleId", "permissions", "features", "version"],
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionGrant"
            }
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      },
      "Invite": {
        "description": "An invitation that has been emailed. The link is not returned.",
        "type": "object",
        "required": ["id", "email", "roleId", "expiresInHours"],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          },
          "expiresInHours": {
            "type": "integer"
          }
        }
      }
    }
  },
  "paths": {
    "/tenant": {
      "get": {
        "operationId": "getTenant",
        "tags": ["tenancy"],
        "description": "The active hospital of the session and its configuration. Private per session, never CDN-cached.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tenant"
                }
              }
            }
          },
          "401": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "tags": ["auth"],
        "description": "Signs in with email and password and starts a session, returned as an httpOnly cookie. Every failure of the email and password has the same answer, 401 invalid_credentials. An account with an authenticator answers 401 mfa_required until the request also carries `code`, and 401 invalid_mfa_code when the code is wrong.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "minLength": 1,
                    "maxLength": 254,
                    "type": "string"
                  },
                  "password": {
                    "minLength": 1,
                    "maxLength": 1024,
                    "type": "string"
                  },
                  "code": {
                    "minLength": 1,
                    "maxLength": 32,
                    "description": "Authenticator code, or a recovery code. Only for accounts that have one.",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Standard error body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": ["auth"],
        "description": "Ends the session, on the server and in the browser. Succeeds whether or not there was one.",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "403": {
            "description": "Standard error body.",
            "content": {
