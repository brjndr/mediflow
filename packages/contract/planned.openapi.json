{
  "info": {
    "title": "Mediflow API: planned endpoints",
    "description": "Endpoints the web app is built against that the API does not implement yet. Hand-written. When the API implements one, delete it here: the generated spec then provides it."
  },
  "paths": {
    "/auth/password/change": {
      "post": {
        "operationId": "changePassword",
        "description": "Changes the signed-in user's password. Asks for the current password. Every other session of the user is ended; the one making the call stays signed in.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "currentPassword": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The password was changed"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/sessions": {
      "get": {
        "operationId": "listAccountSessions",
        "description": "The signed-in user's own active sessions, newest first. A user has few, so there is one page.",
        "responses": {
          "200": {
            "description": "The sessions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountSessionList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/sessions/{sessionId}": {
      "delete": {
        "operationId": "revokeAccountSession",
        "description": "Ends one of the signed-in user's other sessions: that browser is signed out on its next request. The session making the call cannot be ended here (use sign-out).",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The session was ended"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/session/open-link": {
      "post": {
        "operationId": "openLink",
        "description": "Opens a deep link to a record by its globally unique id. The server finds the hospital that owns the record, checks that the user is an active member of it, and rebinds the session to that hospital if another one (or none) is active. Every refusal is the same 403 link_unavailable, whether the record does not exist or belongs to a hospital the user does not work at, so a link cannot be used to find out what exists.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["kind", "id"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "description": "The kind of record, e.g. notice."
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The session, bound to the hospital that owns the record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/notices": {
      "get": {
        "operationId": "listNotices",
        "description": "Staff notices of the active tenant, newest first. Sample feature (F-13). Requires notice:read and the notices feature flag.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of notices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoticePage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/notices/{noticeId}/archive": {
      "post": {
        "operationId": "archiveNotice",
        "description": "Archives a notice so it no longer appears in the list. Requires notice:manage.",
        "parameters": [
          {
            "name": "noticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The archived notice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notice"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/encounters/{encounterId}/charges": {
      "get": {
        "operationId": "listEncounterCharges",
        "description": "The charges posted to a visit, oldest first. Requires charge:read and the billing feature flag. A visit of another hospital is 404.",
        "parameters": [
          {
            "name": "encounterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["pending", "invoiced", "void"]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of charges",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChargePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/encounters/{encounterId}/invoices": {
      "get": {
        "operationId": "listEncounterInvoices",
        "description": "The invoices of a visit, newest first, drafts included. Requires invoice:read and the billing feature flag.",
        "parameters": [
          {
            "name": "encounterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of invoices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoicePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createInvoiceDraft",
        "description": "Makes a draft invoice of a visit from some of its pending charges (409 `charge_unavailable` for one already invoiced, void or in another draft) and lines typed in. A draft needs at least one line (422 `empty_invoice`). Requires invoice:create. The Idempotency-Key header is required. The server works out every line and the invoice total itself; a total sent by a client is never read. A visit that was cancelled has nothing to bill (409 `encounter_cancelled`). Typed lines (`manualLines`) need invoice:adjust as well, since they skip the price list (403 otherwise). Audited. Emits no event until the invoice is issued.",
        "parameters": [
          {
            "name": "encounterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "description": "A unique value chosen by the client. Repeating the request with the same key returns the first result.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceContent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/invoices/{invoiceId}": {
      "get": {
        "operationId": "getInvoice",
        "description": "One invoice. Requires invoice:read and the billing feature flag.",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The invoice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "patch": {
        "operationId": "updateInvoiceDraft",
        "description": "Replaces the content of a draft. 409 `invoice_not_draft` once issued, 409 `version_conflict` when it changed since it was read. Requires invoice:create. The server works out every line and the invoice total itself; a total sent by a client is never read. A visit that was cancelled has nothing to bill (409 `encounter_cancelled`). Typed lines (`manualLines`) need invoice:adjust as well, since they skip the price list (403 otherwise). Audited.",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/invoices/{invoiceId}/issue": {
      "post": {
        "operationId": "issueInvoice",
        "description": "Issues a draft: it gets its number, its charges become invoiced, and it can no longer be changed. Requires invoice:issue. The Idempotency-Key header is required: a repeat answers with the issued invoice. A cancelled visit is 409 `encounter_cancelled`. Audited, and emits `invoice.issued` through the outbox with the tenant, the invoice id, the actor and the time, never the lines.",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "description": "A unique value chosen by the client. Repeating the request with the same key returns the first result.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceIssue"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The issued invoice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Notice": {
        "type": "object",
        "required": ["id", "tenantId", "title", "body", "createdAt", "archived"],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO datetime (UTC)"
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "NoticePage": {
        "type": "object",
        "description": "Cursor envelope used by every list endpoint.",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notice"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AccountSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "createdAt", "lastSeenAt", "userAgent", "current"],
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "userAgent": {
            "type": ["string", "null"],
            "description": "The browser as it described itself at sign-in, for the person to recognise the device."
          },
          "current": {
            "type": "boolean",
            "description": "True for the session making this call."
          }
        }
      },
      "AccountSessionList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountSession"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "Charge": {
        "type": "object",
        "additionalProperties": false,
        "description": "Billable work posted to a visit. Priced when it was posted; never changes afterwards.",
        "required": [
          "id",
          "tenantId",
          "encounterId",
          "source",
          "description",
          "quantity",
          "unitPriceMinor",
          "totalMinor",
          "status",
          "postedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "encounterId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["service", "order", "dispense", "bed", "procedure", "manual"]
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPriceMinor": {
            "type": "integer",
            "minimum": 0
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": ["pending", "invoiced", "void"]
          },
          "invoiceId": {
            "type": "string",
            "description": "The draft invoice holding the charge, when one does."
          },
          "postedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ChargePage": {
        "type": "object",
        "description": "Cursor envelope used by every list endpoint.",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Charge"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "ManualLine": {
        "type": "object",
        "additionalProperties": false,
        "description": "A line the billing desk types in: something not in the price catalog.",
        "required": ["description", "quantity", "unitPriceMinor"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "unitPriceMinor": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "InvoiceLine": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "description", "quantity", "unitPriceMinor", "totalMinor"],
        "properties": {
          "id": {
            "type": "string"
          },
          "chargeId": {
            "type": "string",
            "description": "The charge the line was made from; absent for a manual line."
          },
          "source": {
            "type": "string",
            "enum": ["service", "order", "dispense", "bed", "procedure", "manual"]
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPriceMinor": {
            "type": "integer",
            "minimum": 0
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "description": "A bill of one visit. A draft can be changed; once issued it never is.",
        "required": [
          "id",
          "tenantId",
          "encounterId",
          "patientId",
          "patientName",
          "patientMrn",
          "status",
          "lines",
          "totalMinor",
          "currency",
          "createdAt",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "encounterId": {
            "type": "string"
          },
          "patientId": {
            "type": "string"
          },
          "patientName": {
            "type": "string"
          },
          "patientMrn": {
            "type": "string"
          },
          "number": {
            "type": "string",
            "description": "Given when the invoice is issued."
          },
          "status": {
            "type": "string",
            "enum": ["draft", "issued", "paid", "void"]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLine"
            }
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "InvoicePage": {
        "type": "object",
        "description": "Cursor envelope used by every list endpoint.",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invoice"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "InvoiceContent": {
        "type": "object",
        "additionalProperties": false,
        "description": "What a draft is made of: pending charges of the visit, and lines typed in.",
        "required": ["chargeIds", "manualLines"],
        "properties": {
          "chargeIds": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "manualLines": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/ManualLine"
            }
          }
        }
      },
      "InvoiceUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chargeIds", "manualLines", "version"],
        "properties": {
          "chargeIds": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "manualLines": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/ManualLine"
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "InvoiceIssue": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version"],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
