{
  "info": {
    "title": "Mediflow API: planned endpoints",
    "description": "Endpoints the web app is built against that the API does not implement yet. Hand-written. When the API implements one, delete it here: the generated spec then provides it."
  },
  "paths": {
    "/session/open-link": {
      "post": {
        "operationId": "openLink",
        "description": "Opens a deep link to a record by its globally unique id. The server finds the hospital that owns the record, checks that the user is an active member of it, and rebinds the session to that hospital if another one (or none) is active. Every refusal is the same 403 link_unavailable, whether the record does not exist or belongs to a hospital the user does not work at, so a link cannot be used to find out what exists.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["kind", "id"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "description": "The kind of record, e.g. notice."
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The session, bound to the hospital that owns the record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/notices": {
      "get": {
        "operationId": "listNotices",
        "description": "Staff notices of the active tenant, newest first. Sample feature (F-13). Requires notice:read and the notices feature flag.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of notices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoticePage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/patients/search": {
      "post": {
        "operationId": "searchPatients",
        "description": "Patients of the active tenant, one cursor page at a time. The search term travels in the body, never in a query string, because it can be a name, phone number or MRN. Requires patient:read and the patients feature flag. It reads data only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Search text: name, phone or MRN."
                  },
                  "cursor": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 25
                  },
                  "sort": {
                    "type": "string",
                    "enum": ["name", "-name", "mrn", "-mrn"]
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Sparse fieldset."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One page of patients",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/patients": {
      "post": {
        "operationId": "createPatient",
        "description": "Registers a patient in the active tenant and assigns the MRN. Requires patient:create and the patients feature flag. The Idempotency-Key header makes a retried or double-submitted request return the first result instead of creating a second patient. The server records contactConsent.at and recordedBy.",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 100
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new patient",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientRecord"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/patients/duplicate-check": {
      "post": {
        "operationId": "checkPatientDuplicates",
        "description": "Finds existing patients that may be the same person as one about to be registered. Identifying details travel in the body, never in a query string. Requires patient:create and the patients feature flag. It reads data only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientDuplicateQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Possible matches, possibly none",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientDuplicateMatches"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/notices/{noticeId}/archive": {
      "post": {
        "operationId": "archiveNotice",
        "description": "Archives a notice so it no longer appears in the list. Requires notice:manage.",
        "parameters": [
          {
            "name": "noticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The archived notice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notice"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Notice": {
        "type": "object",
        "required": ["id", "tenantId", "title", "body", "createdAt", "archived"],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO datetime (UTC)"
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "NoticePage": {
        "type": "object",
        "description": "Cursor envelope used by every list endpoint.",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notice"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "PatientSummary": {
        "type": "object",
        "description": "A patient as shown in a list: compact, no clinical data.",
        "required": ["id", "tenantId", "mrn", "firstName", "lastName", "dob", "gender", "phone"],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "mrn": {
            "type": "string",
            "description": "Unique per tenant"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female", "other"]
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "PatientPage": {
        "type": "object",
        "description": "Cursor envelope used by every list endpoint.",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PatientSummary"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "PatientCreate": {
        "type": "object",
        "required": ["firstName", "lastName", "dob", "gender", "phone"],
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female", "other"]
          },
          "phone": {
            "type": "string",
            "minLength": 5,
            "maxLength": 20
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "address": {
            "type": "string",
            "maxLength": 500
          },
          "contactConsent": {
            "type": "object",
            "description": "Only the decision is sent; the server adds when and by whom.",
            "required": ["given"],
            "properties": {
              "given": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "PatientDuplicateQuery": {
        "type": "object",
        "required": ["firstName", "lastName", "dob", "phone"],
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "phone": {
            "type": "string",
            "minLength": 5,
            "maxLength": 20
          }
        }
      },
      "PatientDuplicateMatches": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PatientSummary"
            }
          }
        }
      },
      "PatientRecord": {
        "type": "object",
        "description": "A registered patient with the details captured at registration.",
        "required": ["id", "tenantId", "mrn", "firstName", "lastName", "dob", "gender", "phone"],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "mrn": {
            "type": "string",
            "description": "Unique per tenant"
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female", "other"]
          },
          "phone": {
            "type": "string",
            "minLength": 5,
            "maxLength": 20
          },
          "email": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "contactConsent": {
            "type": "object",
            "required": ["given", "at", "recordedBy"],
            "properties": {
              "given": {
                "type": "boolean"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "recordedBy": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
