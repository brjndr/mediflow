    "/queue/events": {
      "get": {
        "operationId": "queueEvents",
        "description": "Server-sent events for the queues of the session's hospital, and of no other. Each `queue` event says only which department's queue changed (`data: {\"departmentId\":\"...\"}`), never who: the screen then reads the queue again through listQueueTokens, which is audited. A comment line is sent every 20 seconds to keep the connection open; a client takes 45 seconds without anything as a lost connection. The server ends the stream when the session ends, is revoked or switches hospital, and when the session loses queue:read or the hospital the queue switch, and checks the session again before each event. Requires queue:read and the queue feature flag.",
        "responses": {
          "200": {
            "description": "An event stream that stays open",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Notice": {
        "type": "object",
        "required": ["id", "tenantId", "title", "body", "createdAt", "archived"],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO datetime (UTC)"
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "NoticePage": {
        "type": "object",
        "description": "Cursor envelope used by every list endpoint.",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notice"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AccountSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "createdAt", "lastSeenAt", "userAgent", "current"],
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "userAgent": {
            "type": ["string", "null"],
            "description": "The browser as it described itself at sign-in, for the person to recognise the device."
          },
          "current": {
            "type": "boolean",
            "description": "True for the session making this call."
          }
        }
      },
      "AccountSessionList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountSession"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "QueueTokenStatus": {
        "type": "string",
        "enum": ["waiting", "called", "served", "skipped"],
        "description": "waiting -> called -> served, called -> skipped (did not come), skipped -> waiting (came back). A doctor calling the next token makes the one they were serving `served`."
      },
      "QueuePriority": {
        "type": "string",
        "enum": ["senior_citizen", "pregnancy", "disability", "child", "clinical_urgency"],
        "description": "Why a token goes ahead of the others."
      },
      "QueueTokenCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["patientId", "departmentId"],
        "properties": {
          "patientId": {
            "type": "string",
            "maxLength": 64
          },
          "departmentId": {
            "type": "string",
            "maxLength": 64
          },
          "doctorId": {
            "type": "string",
            "maxLength": 64,
            "description": "A practising doctor of the department (422 `doctor_not_in_department` otherwise)."
          },
          "priority": {
            "$ref": "#/components/schemas/QueuePriority"
          }
        }
      },
      "QueueToken": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "number",
          "day",
          "departmentId",
          "departmentName",
          "patientId",
          "patientName",
          "patientMrn",
          "status",
          "issuedAt",
          "callCount",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "description": "The department's number for the day."
          },
          "day": {
            "type": "string",
            "format": "date",
            "description": "The calendar day at the hospital."
          },
          "departmentId": {
            "type": "string"
          },
          "departmentName": {
            "type": "string"
          },
          "doctorId": {
            "type": "string",
            "description": "Absent while any doctor of the department may call it."
          },
          "doctorName": {
            "type": "string"
          },
          "patientId": {
            "type": "string"
          },
          "patientName": {
            "type": "string"
          },
          "patientMrn": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/QueueTokenStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/QueuePriority"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "calledAt": {
            "type": "string",
            "format": "date-time",
            "description": "The last time it was called."
          },
          "callCount": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "QueueTokenPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueToken"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "total": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
