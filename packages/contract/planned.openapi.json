  "components": {
    "schemas": {
      "Notice": {
        "type": "object",
        "required": ["id", "tenantId", "title", "body", "createdAt", "archived"],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO datetime (UTC)"
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "NoticePage": {
        "type": "object",
        "description": "Cursor envelope used by every list endpoint.",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notice"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AccountSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "createdAt", "lastSeenAt", "userAgent", "current"],
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "userAgent": {
            "type": ["string", "null"],
            "description": "The browser as it described itself at sign-in, for the person to recognise the device."
          },
          "current": {
            "type": "boolean",
            "description": "True for the session making this call."
          }
        }
      },
      "AccountSessionList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountSession"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "Code": {
        "type": "object",
        "description": "A diagnosis code (ICD-10) or a procedure code. Reference data shared by every hospital, so it carries no tenant; only `favourite` is the hospital’s own.",
        "required": ["id", "system", "code", "title", "favourite"],
        "properties": {
          "id": {
            "type": "string"
          },
          "system": {
            "type": "string",
            "enum": ["icd10", "procedure"]
          },
          "code": {
            "type": "string",
            "description": "As it is written: A09, E11.9."
          },
          "title": {
            "type": "string"
          },
          "favourite": {
            "type": "boolean",
            "description": "Whether the active tenant marked it."
          }
        }
      },
      "CodePage": {
        "type": "object",
        "description": "Cursor envelope used by every list endpoint.",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Code"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "CodeSearchRequest": {
        "type": "object",
        "required": ["system"],
        "additionalProperties": false,
        "properties": {
          "system": {
            "type": "string",
            "enum": ["icd10", "procedure"],
            "description": "The code set to search."
          },
          "q": {
            "type": "string",
            "maxLength": 100
          },
          "favourites": {
            "type": "boolean",
            "description": "Absent: false."
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Absent: 25."
          }
        }
      },
      "Template": {
        "type": "object",
        "description": "A document template of a hospital. Holds no patient data.",
        "required": ["id", "tenantId", "kind", "name", "version", "savedAt", "archived"],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["prescription", "clinical_note", "consent", "discharge_summary"]
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "The newest version. Sent back as expectedVersion."
          },
          "savedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the newest version was saved."
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "TemplatePage": {
        "type": "object",
        "description": "Cursor envelope used by every list endpoint.",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Template"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "TemplateVersionInfo": {
        "type": "object",
        "required": ["version", "savedAt", "savedByName"],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "savedAt": {
            "type": "string",
            "format": "date-time"
          },
          "savedByName": {
            "type": "string",
            "description": "The member of staff who saved it."
          }
        }
      },
      "TemplateVersion": {
        "type": "object",
        "description": "One version of a template, as it was saved.",
        "required": ["version", "savedAt", "savedByName", "name", "body"],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "savedAt": {
            "type": "string",
            "format": "date-time"
          },
          "savedByName": {
            "type": "string",
            "description": "The member of staff who saved it."
          },
          "name": {
            "type": "string"
          },
          "body": {
            "type": "object",
            "description": "The text of a template: the rich text document of the app (paragraphs, headings, lists, quotes and marks), never HTML. Reduced to that allowlist on the way in. Placeholders are plain text in double braces, `{{patient.name}}`. A placeholder is recognised only inside one run of text, for the check and for filling alike: one that is split by formatting (half of it bold) is neither checked nor ever filled, by any part of the system. Names are trimmed and case-sensitive. A value is filled in as text and is never read for placeholders again.",
            "additionalProperties": true
          }
        }
      },
      "TemplateDetail": {
        "type": "object",
        "required": ["template", "body", "versions"],
        "properties": {
          "template": {
            "$ref": "#/components/schemas/Template"
          },
          "body": {
            "type": "object",
            "description": "The text of a template: the rich text document of the app (paragraphs, headings, lists, quotes and marks), never HTML. Reduced to that allowlist on the way in. Placeholders are plain text in double braces, `{{patient.name}}`. A placeholder is recognised only inside one run of text, for the check and for filling alike: one that is split by formatting (half of it bold) is neither checked nor ever filled, by any part of the system. Names are trimmed and case-sensitive. A value is filled in as text and is never read for placeholders again.",
            "additionalProperties": true
          },
          "versions": {
            "type": "array",
            "description": "Every version, the newest first.",
            "items": {
              "$ref": "#/components/schemas/TemplateVersionInfo"
            }
          }
        }
      },
      "TemplateCreate": {
        "type": "object",
        "required": ["kind", "name", "body"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["prescription", "clinical_note", "consent", "discharge_summary"]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "body": {
            "type": "object",
            "description": "The text of a template: the rich text document of the app (paragraphs, headings, lists, quotes and marks), never HTML. Reduced to that allowlist on the way in. Placeholders are plain text in double braces, `{{patient.name}}`. A placeholder is recognised only inside one run of text, for the check and for filling alike: one that is split by formatting (half of it bold) is neither checked nor ever filled, by any part of the system. Names are trimmed and case-sensitive. A value is filled in as text and is never read for placeholders again.",
            "additionalProperties": true
          }
        }
      },
      "TemplateSave": {
        "type": "object",
        "required": ["expectedVersion"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "body": {
            "type": "object",
            "description": "The text of a template: the rich text document of the app (paragraphs, headings, lists, quotes and marks), never HTML. Reduced to that allowlist on the way in. Placeholders are plain text in double braces, `{{patient.name}}`. A placeholder is recognised only inside one run of text, for the check and for filling alike: one that is split by formatting (half of it bold) is neither checked nor ever filled, by any part of the system. Names are trimmed and case-sensitive. A value is filled in as text and is never read for placeholders again.",
            "additionalProperties": true
          },
          "expectedVersion": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
