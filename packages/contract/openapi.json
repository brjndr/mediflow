{
  "openapi": "3.1.0",
  "info": {
    "title": "Mediflow API",
    "version": "0.0.0",
    "description": "Placeholder spec. apps/api generates this file from its TypeBox route schemas (BE-03). Do not edit by hand once the API exists."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/session": {
      "get": {
        "operationId": "getSession",
        "description": "Bootstraps the app in one request: the signed-in user, the active tenant with its config, and the effective access policy. Private per session, never CDN-cached.",
        "responses": {
          "200": {
            "description": "The current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Standard error body. The message is for logs and developers, never shown to users: the web app maps code to a translated message.",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable machine-readable code, e.g. tenant_mismatch"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": ["tenantId", "tenantName", "roleId"],
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "name", "memberships"],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        }
      },
      "Tenant": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "locale",
          "timezone",
          "currency",
          "theme",
          "features",
          "auth"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "description": "BCP 47, e.g. en-IN"
          },
          "timezone": {
            "type": "string",
            "description": "IANA, e.g. Asia/Kolkata"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217"
          },
          "theme": {
            "type": "object",
            "required": ["primary"],
            "properties": {
              "primary": {
                "type": "string"
              },
              "logoUrl": {
                "type": "string"
              }
            }
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "auth": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["password", "sso"]
              }
            }
          }
        }
      },
      "PermissionGrant": {
        "type": "object",
        "required": ["permission"],
        "properties": {
          "permission": {
            "type": "string",
            "description": "resource:action"
          },
          "scope": {
            "type": "string",
            "enum": ["all", "own", "department"]
          }
        }
      },
      "AccessPolicy": {
        "type": "object",
        "required": ["tenantId", "roleId", "permissions", "features", "version"],
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionGrant"
            }
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["user", "activeTenant", "policy"],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "activeTenant": {
            "description": "Null until a user with several hospitals picks one.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/Tenant"
              },
              {
                "type": "null"
              }
            ]
          },
          "policy": {
            "description": "Null when there is no active tenant.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/AccessPolicy"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
